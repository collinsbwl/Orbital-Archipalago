# syntax=docker/dockerfile:1.7
# Builds the Vite SPA (@orbital/web) and serves it with Caddy.
# Caddy also reverse-proxies /ws, /api/*, and /healthz to the engine
# service on the compose network.

FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
# Vite inlines VITE_* at build time, so they are build args (local .env files never enter the context; see .dockerignore).
# /ws is this page's own origin, which Caddy below proxies to the engine. Auth0 stays off unless domain and client id are set.
ARG VITE_ENGINE_WS_URL=/ws
ARG VITE_AUTH0_DOMAIN=
ARG VITE_AUTH0_CLIENT_ID=
ARG VITE_AUTH0_AUDIENCE=
ENV VITE_ENGINE_WS_URL=${VITE_ENGINE_WS_URL} VITE_AUTH0_DOMAIN=${VITE_AUTH0_DOMAIN} \
    VITE_AUTH0_CLIENT_ID=${VITE_AUTH0_CLIENT_ID} VITE_AUTH0_AUDIENCE=${VITE_AUTH0_AUDIENCE}
RUN pnpm --filter "@orbital/web..." build

FROM caddy:2-alpine AS runtime
COPY --from=build /repo/apps/web/dist /srv
COPY apps/web/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
