{
  "name": "@orbital/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "fixtures"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts --cycles 200",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "record-snapshots": "tsx scripts/record-snapshots.ts"
  },
  "dependencies": {
    "@orbital/contracts": "workspace:*",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@orbital/ledger-memory": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
