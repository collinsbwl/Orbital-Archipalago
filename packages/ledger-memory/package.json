  },
  "dependencies": {
    "@orbital/contracts": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
