{
  "name": "@orbital/ledger-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./contract": { "types": "./dist/contract/suite.d.ts", "default": "./dist/contract/suite.js" }
  },
  "files": ["dist"],
  "scripts": {
