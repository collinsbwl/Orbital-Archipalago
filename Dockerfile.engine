# syntax=docker/dockerfile:1.7
# Multi-stage build for the engine service (@orbital/engine-server).
# Builds the server and its workspace deps, then produces a self-contained
# runtime image via `pnpm deploy --prod`.

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /repo

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
RUN pnpm -r --filter @orbital/engine-server... build

FROM base AS deploy
COPY --from=build /repo /repo
RUN pnpm deploy --filter @orbital/engine-server --prod /out

FROM node:22-alpine AS runtime
WORKDIR /app
COPY --from=deploy /out .
ENV NODE_ENV=production
ENV ENGINE_PORT=8080
EXPOSE 8080
CMD ["node", "dist/main.js"]
